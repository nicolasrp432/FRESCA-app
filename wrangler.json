{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fresca-app",
	"main": "server/worker.ts",
	"compatibility_date": "2025-02-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"kv_namespaces": [
		{
			"binding": "FRESCA_KV",
			"id": "f0a992ac8c944555a01f0aeb7560d7c7",
			"remote": true
		}
	],
	"ai": {
		"binding": "AI"
	}
}