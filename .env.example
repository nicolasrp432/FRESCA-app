# Servidor (no se expone al navegador)
# Usa Google AI Studio (gratuita en https://aistudio.google.com/app/apikey) o OpenRouter (https://openrouter.ai)
GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# Opcional: modelo para visión y recetas (por defecto gemini-2.5-flash)
# FRESCA_MODEL=gemini-2.5-flash
PORT=8787

# Opcional: cuentas (SMS / Google) y copia en la nube con Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
